#!/usr/bin/env bash
# The gate, before anything leaves this machine.
#
# CI runs the same roster, but CI runs *after* the push — and a push to a
# public repository is already public. GitHub keeps unreachable objects
# reachable by SHA for a long time, so "force-push over it" is not a delete.
# This hook is the only check that happens while a mistake is still local.
#
# Install: git config core.hooksPath .githooks
set -uo pipefail
# Paths and pathspecs from the top, however the hook is invoked: run by hand
# from a subdirectory, `git grep` would search only that subtree and report
# the whole repository clean — and `:!LICENSE` would exclude nothing.
cd "$(git rev-parse --show-toplevel)" || exit 1
# git passes the remote's name (or URL) as $1: the only remote whose refs say
# what is already public here.
remote=${1:-}

# The roster lives outside this repository on purpose — it is a list of what
# must never appear here, which makes it the most sensitive file in the set.
ROSTER="${MECHA_GRAPH_DENYLIST:-$HOME/.mecha-graph/denylist.txt}"

# **Fail closed.** A missing roster means the check cannot run, and a check
# that cannot run must stop the push rather than wave it through. This is the
# silently-degrading-guard rule; the whole point is that the failure mode is
# loud.
if [ ! -r "$ROSTER" ]; then
    cat >&2 <<MSG
pre-push REFUSED: no denylist roster at $ROSTER

  The roster is deliberately not in this repository. Restore it, or point
  MECHA_GRAPH_DENYLIST at it, before pushing.

  This is not a warning you can push past: an unchecked push to a public
  repository cannot be taken back.
MSG
    exit 1
fi

# ── The roster ────────────────────────────────────────────────────────────
#
# Every way of writing the file that could silently shrink what gets checked
# is either tolerated or refused, never passed over: a last line with no
# trailing newline (`read` would drop it — and it is the line just added), CRLF
# endings (every term would carry a `\r` and match nothing), stray spaces, and
# a line with a kind but no term.
w_terms=()
p_terms=()
n=0
while IFS= read -r line || [ -n "$line" ]; do
    n=$((n+1))
    line=${line%$'\r'}
    case "$line" in ''|'#'*) continue ;; esac
    kind=${line%% *}
    term=${line#"$kind"}
    term="${term#"${term%%[![:space:]]*}"}"
    term="${term%"${term##*[![:space:]]}"}"
    if [ -z "$term" ]; then
        echo "pre-push REFUSED: roster line $n has a kind but no term" >&2
        exit 1
    fi
    case "$kind" in
        # Word boundary for short terms, substring for phrases. Losing this
        # distinction is not a near-miss: on the first run it flagged two
        # ordinary words that merely contained a short term, and refused a
        # clean tree. (Which words is deliberately not written down: naming
        # them would tell a reader which letters a roster term is made of.)
        w) w_terms+=("$term") ;;
        p) p_terms+=("$term") ;;
        *) echo "pre-push REFUSED: roster line $n: unknown kind '$kind'" >&2; exit 1 ;;
    esac
done < "$ROSTER"
terms=$(( ${#w_terms[@]} + ${#p_terms[@]} ))
if [ "$terms" -eq 0 ]; then
    echo "pre-push REFUSED: roster at $ROSTER parsed to zero terms" >&2
    exit 1
fi

# ── What is being pushed ──────────────────────────────────────────────────
#
# git hands a pre-push hook one line per ref: <local ref> <local sha>
# <remote ref> <remote sha>. The check is on the COMMITS those refs carry that
# the remote does not have yet — every one of them, not only the tip, since an
# intermediate commit is public by SHA once pushed even if a later one removed
# the leak — and not on whatever happens to be checked out (`git push origin
# other-branch` would otherwise check the wrong tree). Run by hand, with no
# push on stdin, it checks the working tree.
commits=()
tags=()
refs_seen=0
if [ ! -t 0 ]; then
    while read -r _lref lsha _rref rsha; do
        [ -n "${lsha:-}" ] || continue
        refs_seen=1
        case "$lsha" in *[!0]*) ;; *) continue ;; esac   # a branch deletion
        # A new branch, or a remote tip this clone has never fetched: every
        # commit the push TARGET's tracking refs do not already have. Not
        # `--remotes` whole — with a private remote in the same clone, its
        # commits are exactly the ones that must not be skipped. A URL, or a
        # remote with no tracking refs, matches none: every commit reachable
        # from the tip is checked, which is slow and right.
        if [[ "$rsha" == *[!0]* ]] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
            range=("$rsha..$lsha")
        else
            range=("$lsha" --not --remotes="${remote:-no-remote-given}")
        fi
        # Unknown is never clean: commits that cannot be listed are commits
        # that cannot be checked.
        if ! list=$(git rev-list "${range[@]}"); then
            echo "pre-push REFUSED: could not list the commits being pushed" >&2
            exit 1
        fi
        [ -n "$list" ] && while read -r c; do commits+=("$c"); done <<<"$list"
        # An annotated tag carries a message of its own, pushed and public;
        # `rev-list` resolves through it to commits and never sees it.
        [ "$(git cat-file -t "$lsha" 2>/dev/null)" = tag ] && tags+=("$lsha")
    done
fi
# By hand means git passed no ref lines — not "stdin is a terminal": run from
# a script, a Makefile or `</dev/null`, a tty test would read as "nothing to
# push" and print clean having checked nothing.
by_hand=0
[ "$refs_seen" -eq 0 ] && by_hand=1

# ── The check ─────────────────────────────────────────────────────────────
#
# Terms are fixed strings, never regular expressions (`-F`, for `w` terms too):
# a term containing `(` or `[` is a broken regex, and git grep's error exit
# must not read as "no match". Any exit other than 0 (found) or 1 (not found)
# refuses the push. LICENSE carries the copyright holder's name by definition,
# and always will — excluded exactly as the original export gate excluded it.
fail=0
# By hand, the working tree includes files not yet added (`--untracked`,
# which still skips ignored ones): a name in a new file is one commit away
# from a push. Pushing, the commits themselves are the targets.
if [ "$by_hand" -eq 1 ]; then targets=(--untracked); else targets=(${commits[@]+"${commits[@]}"}); fi
grep_terms() { # grep_terms <flags> <term>... — over every target at once
    local flags=$1; shift
    local e=(); for t in "$@"; do e+=(-e "$t"); done
    git grep "$flags" ${e[@]+"${e[@]}"} ${targets[@]+"${targets[@]}"} -- ':!LICENSE' 2>&1
}
scan() { # scan <flags> <term>... — one pass; per-term only to name a hit
    local flags=$1; shift
    [ "$#" -gt 0 ] || return 0
    local out rc
    out=$(grep_terms "$flags" "$@"); rc=$?
    case "$rc" in
        0)  for t in "$@"; do
                out=$(grep_terms "$flags" "$t"); rc=$?
                case "$rc" in
                    0)  # Local-only output, so naming the term is safe here
                        # and is what makes the finding actionable — the CI
                        # job deliberately cannot.
                        echo "DENYLIST HIT [$t]:" >&2
                        printf '%s\n' "$out" | sed 's/^/  /' >&2
                        fail=1 ;;
                    1)  ;;
                    *)  echo "pre-push REFUSED: git grep failed (exit $rc):" >&2
                        printf '%s\n' "$out" | sed 's/^/  /' >&2; exit 1 ;;
                esac
            done ;;
        1)  ;;
        *)  echo "pre-push REFUSED: git grep failed (exit $rc):" >&2
            printf '%s\n' "$out" | sed 's/^/  /' >&2; exit 1 ;;
    esac
}
if [ "$by_hand" -eq 1 ] || [ ${#commits[@]} -gt 0 ]; then
    scan -IliwF ${w_terms[@]+"${w_terms[@]}"}
    scan -IliF ${p_terms[@]+"${p_terms[@]}"}
fi

# Commit and tag messages are pushed too, and rendered as publicly as any
# file — the likeliest place a first name lands casually ("per <name>'s
# note"). Messages only: the author and committer fields are the owner's own
# name and address, public by definition like LICENSE. Each message is read
# into a variable and grepped from there: `git log | grep -q` under pipefail
# reports a match as a failure when grep exits early and git takes SIGPIPE.
scan_messages() { # scan_messages <flags> <term>...
    local flags=$1; shift
    local t o msg rc
    for t in "$@"; do
        for o in ${commits[@]+"${commits[@]}"} ${tags[@]+"${tags[@]}"}; do
            if [ "$(git cat-file -t "$o")" = tag ]; then
                msg=$(git cat-file tag "$o" | sed '1,/^$/d')
            else
                msg=$(git log -1 --format=%B "$o")
            fi
            rc=0
            grep -q "$flags" -e "$t" <<<"$msg" || rc=$?
            case "$rc" in
                0)  echo "DENYLIST HIT [$t] in the message of $(git cat-file -t "$o") ${o:0:12}" >&2
                    fail=1 ;;
                1)  ;;
                *)  echo "pre-push REFUSED: grep failed (exit $rc) on a message" >&2; exit 1 ;;
            esac
        done
    done
}
if [ $(( ${#commits[@]} + ${#tags[@]} )) -gt 0 ]; then
    scan_messages -iwF ${w_terms[@]+"${w_terms[@]}"}
    scan_messages -iF ${p_terms[@]+"${p_terms[@]}"}
fi

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-push REFUSED: $terms term(s) checked, see hits above." >&2
    exit 1
fi
if [ "$by_hand" -eq 1 ]; then
    echo "denylist: clean ($terms terms, working tree)"
else
    echo "denylist: clean ($terms terms, ${#commits[@]} new commit(s))"
fi
